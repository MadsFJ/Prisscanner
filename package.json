{
  "name": "prisscanner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @prisscanner/db generate",
    "db:migrate": "pnpm --filter @prisscanner/db migrate",
    "db:seed": "pnpm --filter @prisscanner/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "~6.0.3"
  }
}
