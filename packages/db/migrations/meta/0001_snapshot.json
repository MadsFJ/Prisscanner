        }
      },
      "definition": "\n  select\n    pm.id,\n    pm.tracked_item_id,\n    o.id as offer_id,\n    r.slug as retailer_slug,\n    r.name as retailer_name,\n    coalesce(s.name, r.name) as store_name,\n    o.title,\n    o.price_ore,\n    o.unit_price_ore,\n    o.base_unit,\n    o.source,\n    o.valid_from,\n    o.valid_to,\n    (o.valid_from <= now() and (o.valid_to is null or o.valid_to > now())) as is_current,\n    (o.source = 'flyer' and o.valid_from > now()) as is_future_flyer,\n    pm.score,\n    o.source_url\n  from price_matches pm\n  join offers o on o.id = pm.offer_id\n  join retailers r on r.id = o.retailer_id\n  left join stores s on s.id = o.store_id\n",
      "name": "price_match_details",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
